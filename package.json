{
  "name": "react-search-panel",
  "version": "2.0.0",
  "description": "An expandable search panel React component where results can be displayed as links, checkboxes, or radio buttons, with optional chips.",
  "author": "Jeremy Davidson",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/react-search-panel.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremydavidson/react-search-panel.git"
  },
  "bugs": {
    "url": "https://github.com/jeremydavidson/react-search-panel/issues"
  },
  "homepage": "https://jeremydavidson.github.io/react-search-panel",
  "keywords": [
    "react-search-panel",
    "react",
    "react-component",
    "material-design",
    "google",
    "search",
    "search-bar",
    "search-panel",
    "expandable",
    "multiple choice",
    "radio-button",
    "checkbox",
    "links"
  ],
  "scripts": {
    "build": "vite build",
    "build-storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook build -o docs/storybook",
    "deploy": "gh-pages -d docs -t true",
    "doc": "typedoc --options typedoc.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "predeploy": "cp README.md docs && cp typedoc.md docs && cp _config.yml docs && cp assets/react-search-panel-demo.gif docs && npm run doc && npm run build-storybook && npm run build:example",
    "build:example": "npm run build --prefix example",
    "prepublishOnly": "npm run build",
    "start": "vite build --watch",
    "storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "react-cool-onclickoutside": "^1.7.0",
    "react-use-keypress": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axios": "^1.13.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12"
  }
}
